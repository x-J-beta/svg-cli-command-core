    {"id": "E14", "command": "scale r -2", "error": "scale factor must be positive"},
    {"id": "E15", "command": "scale r Infinity", "error": "expected finite number"},
    {"id": "E16", "command": "scale empty 0", "setup": ["init", "create g empty"], "error": "scale factor must be positive"},
    {"id": "E17", "command": "set r id other", "error": "unknown attribute: id"},
    {"id": "E18", "command": "set r text other", "error": "unknown attribute: text"},
